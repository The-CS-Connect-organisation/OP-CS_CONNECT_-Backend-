# ============================================================
# CORNERSTONE BACKEND — ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── JWT ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Supabase ─────────────────────────────────────────────────
# From: supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Your deployed frontend URL (academics portal)
CORS_ORIGIN=https://the-cs-connect-organisation.github.io

# ── AI Providers (at least one required) ─────────────────────
# Cerebras: https://cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=

# Groq: https://console.groq.com → API Keys
GROQ_API_KEY=

# Gemini: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=

# ── Stream Chat ───────────────────────────────────────────────
# GetStream: https://dashboard.getstream.io → App → API Keys
STREAM_API_KEY=
STREAM_API_SECRET=
